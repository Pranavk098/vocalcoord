# backend/.env.example
# Copy to backend/.env and fill in real values. Never commit backend/.env.

ANTHROPIC_API_KEY=

ELEVENLABS_AGENT_ID=

CORS_ORIGINS=http://localhost:3000

# Shared secret for HMAC-verifying ElevenLabs webhook signatures.
# (Security fix landing separately.)
WEBHOOK_SECRET=

# When true, missing fault codes/locations fall back to demo defaults
# instead of asking the driver to clarify. (Fix landing separately.)
DEMO_MODE=true

# HYBRID ownership flags (see docs/adr/0005-hybrid-owned-stt-llm.md).
# Owned LLM: local Ollama first with Anthropic fallback, or Anthropic directly.
PROVIDER_LLM=anthropic
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Owned STT model for POST /stt (Faster-Whisper). TTS stays ElevenLabs unless piper.
STT_MODEL=small.en
# ElevenLabs TTS path stays intact; set to piper to route new TTS via owned Piper.
PROVIDER_TTS=elevenlabs
